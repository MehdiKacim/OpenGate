{
  "name": "opengate",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "start": "node apps/server/dist/index.js",
    "cli": "tsx apps/server/src/cli.ts",
    "cli:built": "node apps/server/dist/cli.js",
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "pnpm --filter @opengate/web dev",
    "validate": "node apps/server/dist/cli.js validate",
    "test": "vitest --run",
    "lint": "eslint .",
    "docs": "pnpm docs:api && pnpm docs:db",
    "docs:components": "pnpm exec react-docgen apps/web/src --out docs/components/react-docgen.json || echo 'react-docgen skipped'",
    "docs:typedoc": "pnpm exec typedoc packages --out docs/api/typedoc || echo 'typedoc skipped'",
    "docs:api": "node scripts/generate-openapi.js",
    "docs:db": "node scripts/generate-db-docs.js",
    "smoke": "tsx scripts/smoke.ts",
    "package:windows": "pnpm build && node scripts/package-windows.js"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "typedoc": "^0.26.0",
    "react-docgen": "^7.0.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=20.0.0 <23"
  }
}
